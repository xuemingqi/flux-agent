# Optional initial settings. Prefer the model settings page; saved settings take precedence.
# OpenAI-compatible Chat Completions endpoint; include /v1 when your provider requires it.
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_API_KEY=
MODEL_NAME=
# Some compatible gateways do not support stream_options.include_usage.
MODEL_STREAM_USAGE=false
PORT=3000
WEB_PORT=5173
# SQLite database directory. Default: ~/.flux-agent
# FLUX_DATA_DIR=/your/private/data-directory
# Used only when initializing the first workspace; more can be added in the UI.
# FLUX_WORKSPACE_DIR=/your/project-directory
